# Copy to .env.local and fill in. NEVER commit .env.local (it holds real keys).
# Both values are T3N API keys from the claim page.

# Primary key — acts as the tenant that registers the contracts.
T3N_API_KEY=0xyour_primary_key_here
DID=did:t3n:your_tenant_did_here

# Second key — acts as a calling agent (mapped to AGENT_KEY automatically).
T3N_API_KEY_2=0xyour_second_key_here
DID_2=did:t3n:your_agent_did_here

# Optional: testnet | sandbox | production (defaults to testnet)
# T3N_ENVIRONMENT=testnet
